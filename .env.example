# Environment Configuration for Azure B1ls Deployment

# Server
PORT=3000
NODE_ENV=production

# Memory & Performance
MAX_CACHE_SIZE=500
CACHE_TTL_DAYS=7

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_RECOMMEND=5
RATE_LIMIT_WINDOW_MINUTES=1

# Timeouts (ms)
BOOK_API_TIMEOUT=3000
MUSIC_API_TIMEOUT=5000
GEMINI_TIMEOUT=10000

# Features
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMIT=true
ENABLE_GEMINI=true

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
BOOK_API_BASE_URL=http://book-api-url.com/api
BOOK_API_KEY=your_book_api_key_here
MUSIC_API_BASE_URL=http://music-api-url.com/api
MUSIC_API_KEY=your_music_api_key_here
